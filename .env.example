# Copy to .env locally. Never commit it, paste its contents in chat, or put it in portal/.
# Only deployment keys belong here. Merchant and executor sign in their browser wallets.
# All URLs below are TESTNETS. Fill merchant addresses, deployment keys and Solana paths.
# Values are literal dotenv values: no shell expansion or command substitution.
TESTNET_NETWORKS=tempo,solana

# Optional shared EVM defaults (same public address across the configured EVM networks).
# Leave blank if using the per-network overrides below.
EVM_MERCHANT_ADDRESS=
EVM_DEPLOYER_PRIVATE_KEY=

# Solana Devnet: keypair JSON file paths, never a seed phrase.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MERCHANT_ADDRESS=
SOLANA_DEPLOYER_KEYPAIR_PATH=
SOLANA_PROGRAM_KEYPAIR_PATH=
# Generate a fresh program keypair; never use the local fixture program publicly.

# Tempo Moderato: fund deployer with AlphaUSD gas; sUSD is a separate TIP-20.
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_MERCHANT_ADDRESS=
TEMPO_DEPLOYER_PRIVATE_KEY=
TEMPO_FEE_TOKEN=0x20c0000000000000000000000000000000000001

# Ethereum Sepolia: ETH gas.
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_MERCHANT_ADDRESS=
ETHEREUM_DEPLOYER_PRIVATE_KEY=

# Base Sepolia: Base Sepolia ETH gas.
BASE_RPC_URL=https://sepolia.base.org
BASE_MERCHANT_ADDRESS=
BASE_DEPLOYER_PRIVATE_KEY=

# Arbitrum Sepolia: Arbitrum Sepolia ETH gas.
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_MERCHANT_ADDRESS=
ARBITRUM_DEPLOYER_PRIVATE_KEY=

# Robinhood Chain Testnet: ETH gas.
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MERCHANT_ADDRESS=
ROBINHOOD_DEPLOYER_PRIVATE_KEY=


# TRON Nile: TRX/energy/bandwidth. Shasta uses 2494104990 + its matching RPC.
TRON_RPC_URL=https://nile.trongrid.io
TRON_CHAIN_ID=3448148188
TRON_MERCHANT_ADDRESS=
TRON_DEPLOYER_PRIVATE_KEY=
TRON_FEE_LIMIT=1000000000

# BNB Smart Chain testnet: BNB gas.
BNB_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_DEPLOYER_PRIVATE_KEY=

# Optional <CHAIN>_PAYMENT_TOKEN configures an existing test asset; EVM factory deployment does not mint.
# Verified public activation registry: portal/public/deployments/main.json.
# Solana/TRON complete checkpoints require explicit activation after verification.
# Raw checkpoints and private RPC URLs remain in ignored .data/deployments/.
# No deployment or mint occurs without the explicit --broadcast flag.
