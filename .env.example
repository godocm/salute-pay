# Development configuration only. Copy to .env locally; never commit private keys.
# Existing EVM local lab starts with `npm run dev` and needs no environment values.

# EVM testnet CLI deployment / independent executor
RPC_URL=
EXPECTED_CHAIN_ID=
FACTORY_ADDRESS=
# PRIVATE_KEY=                  # Dedicated funded testnet deployer; omit for read-only commands
# EXECUTOR_PRIVATE_KEY=         # Dedicated funded testnet executor; never a custody key

# Solana local test program and read-only observer
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_OBSERVER_PORT=8790
SOLANA_PROGRAM_ID=
SOLANA_TOKEN_MINT=
# SOLANA_DEVNET_RPC_URL=       # Use only for deliberate testnet operations
# SOLANA_DEPLOYER_KEYPAIR_PATH= # Local testnet keypair file path; never paste key material here
# SOLANA_EXECUTOR_KEYPAIR_PATH= # Native SOL for transaction fees; no deposit custody key

# TRON local TRE and read-only observer
TRON_FULL_NODE_URL=http://127.0.0.1:9090
TRON_OBSERVER_PORT=8791
TRON_EVENT_SERVER_URL=
TRON_FACTORY_ADDRESS=
TRON_USDT_ADDRESS=
# PRIVATE_KEY_DEV=               # Only a disposable local TRE key for TronBox tests
# TRON_DEPLOYER_KEY_PATH=       # Testnet key file path, not a gateway deposit key
# TRON_EXECUTOR_KEY_PATH=       # Testnet fee payer; no authority over merchant payout
