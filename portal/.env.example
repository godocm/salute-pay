# Server only: pooled PostgreSQL URL from Neon or another provider. Never use NEXT_PUBLIC_ for database credentials.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:5173
CRON_SECRET=
# Public project identifier, not a wallet key. Allowlist your deployed app origin in Reown.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional private RPC overrides: RPC_ETHEREUM, RPC_SOLANA, RPC_TEMPO, RPC_TRON etc.
# Verified deployment metadata belongs in public/deployments/main.json. No keys/private RPC URLs in that file.
